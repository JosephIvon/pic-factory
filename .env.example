# 环境变量示例（复制为 .env 并填真实值；.env 已被 gitignore）
# —— 上游流水线（matrix/本地栈/replay）——
AP_MATRIX_CLI=mcode-tools            # MiniMax 连接器 CLI（仅参照后端，不可交付）
AP_FACE_THRESHOLD=                   # 留空=用同域标定值 0.57（docs/ab-evidence/threshold-calibration-production.json）；填值则覆盖
AP_COST_API=                         # API 单张价（元）；未配置时报告显示"未配置单价"
AP_LOCAL_WATT=150
AP_KWH_PRICE=0.6
AP_LOCAL_DEPR_PER_HOUR=
AP_LOCAL_PRESET=turbo                # turbo | photo
AP_LOCAL_PYTHON=                     # 本地栈 3.12 venv 的 python 路径

# —— 标准 API 后端（整合新增，可交付）——
AP_ARK_KEY=                          # 火山方舟 API key（Seedream 系）
AP_DASHSCOPE_KEY=                    # 阿里百炼 API key（Qwen-Image / 万相）

# —— 预算闸（整合新增）——
AP_BUDGET_CNY=                       # 批次预算帽；达 80% 停止新调用，只允许 replay
AP_CONCURRENCY=4                     # http_api 跑批并发数（1=串行；钳位 1~16；令牌桶/熔断均线程安全）

# —— 面板鉴权（P0-3）——
AP_PANEL_TOKEN=                      # 随机串。docker compose up 必填（容器面板绑 0.0.0.0，fail-closed 拒启动）；
                                     # 本机 aesthetics panel（127.0.0.1）留空=零门槛。浏览器 /?token=… 引导 cookie

# —— 域包（行业数据；换行业不改代码，见 docs/DOMAIN-PACKS.md）——
AP_PACK=                             # 留空=旧路径(data/tasks.yaml+prompts)；medical-aesthetics | example-retail
AP_PACKS_DIR=                        # 客户自带行业包目录（默认 <repo>/packs）
